{
  "id": "everyday",
  "name": "Everyday",
  "description": "A general-purpose layout for day to day use: media, volume, brightness, window snapping and a couple of safe system shortcuts. Good starting point before building an app-specific layout.",
  "bindings": [
    {
      "id": "b1",
      "enabled": true,
      "gesture": "double",
      "zone": "right-palm",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "media",
        "command": "playpause"
      },
      "label": "Play or pause",
      "presetId": "media-play-pause"
    },
    {
      "id": "b2",
      "enabled": true,
      "gesture": "double",
      "zone": "left-palm",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "app",
        "op": "switch-next"
      },
      "label": "Switch to next app",
      "presetId": "app-switch-next"
    },
    {
      "id": "b3",
      "enabled": true,
      "gesture": "tap",
      "zone": "right-grille",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "volume",
        "step": 6
      },
      "label": "Volume up",
      "presetId": "vol-up"
    },
    {
      "id": "b4",
      "enabled": true,
      "gesture": "tap",
      "zone": "left-grille",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "volume",
        "step": -6
      },
      "label": "Volume down",
      "presetId": "vol-down"
    },
    {
      "id": "b5",
      "enabled": true,
      "gesture": "double",
      "zone": "right-grille",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "mute"
      },
      "label": "Mute or unmute",
      "presetId": "vol-mute"
    },
    {
      "id": "b6",
      "enabled": true,
      "gesture": "tap",
      "zone": "top-strip",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "system",
        "op": "mission-control"
      },
      "label": "Mission Control",
      "presetId": "sys-mission-control"
    },
    {
      "id": "b7",
      "enabled": true,
      "gesture": "double",
      "zone": "top-strip",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "system",
        "op": "show-desktop"
      },
      "label": "Show desktop",
      "presetId": "sys-show-desktop"
    },
    {
      "id": "b8",
      "enabled": true,
      "gesture": "tap",
      "zone": "left-edge",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "brightness",
        "step": -1
      },
      "label": "Brightness down",
      "presetId": "bright-down"
    },
    {
      "id": "b9",
      "enabled": true,
      "gesture": "tap",
      "zone": "right-edge",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "brightness",
        "step": 1
      },
      "label": "Brightness up",
      "presetId": "bright-up"
    },
    {
      "id": "b10",
      "enabled": true,
      "gesture": "double",
      "zone": "left-edge",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "window",
        "op": "left"
      },
      "label": "Window to left half",
      "presetId": "win-left"
    },
    {
      "id": "b11",
      "enabled": true,
      "gesture": "double",
      "zone": "right-edge",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "window",
        "op": "right"
      },
      "label": "Window to right half",
      "presetId": "win-right"
    },
    {
      "id": "b12",
      "enabled": true,
      "gesture": "triple",
      "zone": "lid",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "app",
        "op": "quit"
      },
      "label": "Quit frontmost app",
      "presetId": "app-quit"
    },
    {
      "id": "b13",
      "enabled": true,
      "gesture": "cover_hold",
      "zone": null,
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "system",
        "op": "lock"
      },
      "label": "Lock screen",
      "presetId": "sys-lock"
    },
    {
      "id": "b14",
      "enabled": true,
      "gesture": "sequence",
      "zone": null,
      "zones": [
        "left-palm",
        "right-palm"
      ],
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "window",
        "op": "maximize"
      },
      "label": "Fill the screen",
      "presetId": "win-maximize"
    }
  ]
}
