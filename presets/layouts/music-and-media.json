{
  "id": "music-and-media",
  "name": "Music and media",
  "description": "Playback, volume and brightness within reach, plus a tilt gesture for skipping tracks without touching the keyboard.",
  "bindings": [
    {
      "id": "b1",
      "enabled": true,
      "gesture": "double",
      "zone": "right-palm",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "media",
        "command": "playpause"
