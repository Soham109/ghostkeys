      "enabled": true,
      "gesture": "tap",
      "zone": "right-edge",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Powerpoint",
      "action": {
        "kind": "keystroke",
        "key": "b",
        "modifiers": []
      },
      "label": "Blank the screen to black",
      "presetId": "pp-black-screen"
