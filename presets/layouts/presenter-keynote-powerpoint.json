      "presetId": "kn-prev-slide"
    },
    {
      "id": "b10",
      "enabled": true,
      "gesture": "tap",
      "zone": "left-grille",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Powerpoint",
      "action": {
