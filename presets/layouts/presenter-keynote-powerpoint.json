      "enabled": true,
      "gesture": "tap",
      "zone": "right-grille",
      "zones": null,
      "modifiers": [],
      "app": "com.apple.iWork.Keynote",
      "action": {
        "kind": "keystroke",
        "key": "down",
        "modifiers": [
          "option"
        ]
      },
      "label": "Next slide",
      "presetId": "kn-next-slide"
