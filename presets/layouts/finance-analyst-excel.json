{
  "id": "finance-analyst-excel",
  "name": "Finance analyst (Excel)",
  "description": "Built around Mac Excel keyboard shortcuts for building and auditing models: AutoSum, paste values, fill, absolute references and row insertion, plus a few general shortcuts for volume and locking the screen.",
  "bindings": [
    {
      "id": "b1",
      "enabled": true,
      "gesture": "double",
      "zone": "right-palm",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "media",
        "command": "playpause"
      },
      "label": "Play or pause",
      "presetId": "media-play-pause"
    },
    {
      "id": "b2",
      "enabled": true,
      "gesture": "double",
      "zone": "left-palm",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "app",
        "op": "switch-next"
      },
      "label": "Switch to next app",
      "presetId": "app-switch-next"
    },
    {
      "id": "b3",
      "enabled": true,
      "gesture": "tap",
      "zone": "right-grille",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "volume",
        "step": 6
      },
      "label": "Volume up",
      "presetId": "vol-up"
    },
    {
      "id": "b4",
      "enabled": true,
      "gesture": "tap",
      "zone": "left-grille",
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "volume",
        "step": -6
      },
      "label": "Volume down",
      "presetId": "vol-down"
    },
    {
      "id": "b5",
      "enabled": true,
      "gesture": "tap",
      "zone": "top-strip",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "t",
        "modifiers": [
          "command",
          "shift"
        ]
      },
      "label": "AutoSum",
      "presetId": "fin-autosum"
    },
    {
      "id": "b6",
      "enabled": true,
      "gesture": "double",
      "zone": "top-strip",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "macro",
        "steps": [
          {
            "kind": "keystroke",
            "key": "v",
            "modifiers": [
              "command",
              "control"
            ]
          },
          {
            "kind": "keystroke",
            "key": "v",
            "modifiers": [],
            "delayMs": 60
          }
        ]
      },
      "label": "Paste values only",
      "presetId": "fin-paste-values"
    },
    {
      "id": "b7",
      "enabled": true,
      "gesture": "tap",
      "zone": "right-edge",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "d",
        "modifiers": [
          "command"
        ]
      },
      "label": "Fill down",
      "presetId": "fin-fill-down"
    },
    {
      "id": "b8",
      "enabled": true,
      "gesture": "tap",
      "zone": "left-edge",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "r",
        "modifiers": [
          "command"
        ]
      },
      "label": "Fill right",
      "presetId": "fin-fill-right"
    },
    {
      "id": "b9",
      "enabled": true,
      "gesture": "double",
      "zone": "right-edge",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "t",
        "modifiers": [
          "command"
        ]
      },
      "label": "Toggle absolute reference",
      "presetId": "fin-toggle-absolute"
    },
    {
      "id": "b10",
      "enabled": true,
      "gesture": "double",
      "zone": "left-edge",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "=",
        "modifiers": [
          "control",
          "shift"
        ]
      },
      "label": "Insert row",
      "presetId": "fin-insert-row"
    },
    {
      "id": "b11",
      "enabled": true,
      "gesture": "tap",
      "zone": "lid",
      "zones": null,
      "modifiers": [],
      "app": "com.microsoft.Excel",
      "action": {
        "kind": "keystroke",
        "key": "f",
        "modifiers": [
          "command",
          "shift"
        ]
      },
      "label": "Toggle filter",
      "presetId": "fin-toggle-filter"
    },
    {
      "id": "b12",
      "enabled": true,
      "gesture": "cover_hold",
      "zone": null,
      "zones": null,
      "modifiers": [],
      "app": "*",
      "action": {
        "kind": "system",
        "op": "lock"
      },
      "label": "Lock screen",
      "presetId": "sys-lock"
    }
  ]
}
