{
  "name": "@ghostkeys/promo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "audio": "node scripts/make-audio.ts",
    "render": "remotion render src/index.ts GhostkeysPromo out/ghostkeys-promo-v2-vo.mp4 --gl=angle && scripts/remux.sh out/ghostkeys-promo-v2-vo.mp4 public/mix-film-vo.wav",
    "render:teaser": "remotion render src/index.ts GhostkeysTeaser out/ghostkeys-teaser-vertical.mp4 --gl=angle",
    "render:all": "pnpm audio && pnpm voice && pnpm mix && pnpm verify && pnpm render && pnpm render:novo && pnpm render:teaser",
    "stills": "node scripts/stills.mjs",
    "typecheck": "tsc -p .",
    "voice": "node scripts/make-voice.ts",
    "voice:list": "node scripts/vo-list.ts",
    "voice:samples": "node scripts/vo-samples.ts",
    "render:novo": "remotion render src/index.ts GhostkeysPromoNoVO out/ghostkeys-promo-v2.mp4 --gl=angle && scripts/remux.sh out/ghostkeys-promo-v2.mp4 public/mix-film-novo.wav",
    "mix": "node scripts/mix.ts",
    "verify": "node_modules/.pnpm/esbuild@0.28.1/node_modules/esbuild/bin/esbuild scripts/verify-sync.ts --bundle --platform=node --format=esm --outfile=voice/work/verify-sync.mjs --log-level=warning && node voice/work/verify-sync.mjs",
    "music:try": "node scripts/music-try.ts"
  },
  "dependencies": {
    "@react-three/fiber": "8",
    "@react-three/postprocessing": "2",
    "@remotion/bundler": "4.0.529",
    "@remotion/cli": "4",
    "@remotion/fonts": "4",
    "@remotion/renderer": "4.0.529",
    "@remotion/shapes": "4",
    "@remotion/three": "4",
    "postprocessing": "6.36",
    "react": "18",
    "react-dom": "18",
    "remotion": "4",
    "three": "0.169"
  },
  "devDependencies": {
    "@types/react": "18",
    "@types/three": "0.169",
    "typescript": "^7.0.2"
  }
}
